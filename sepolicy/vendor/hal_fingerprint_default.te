add_service(hal_fingerprint_default, hal_xiaomi_fingerprint_service)
hal_client_domain(hal_fingerprint_default, hal_touchfeature_xiaomi)

allow hal_fingerprint_default self:capability sys_nice;

# Sensor and touch interfaces
allow hal_fingerprint_default input_device:chr_file rw_file_perms;
allow hal_fingerprint_default input_device:dir r_dir_perms;
allow hal_fingerprint_default touchfeature_device:chr_file rw_file_perms;
allow hal_fingerprint_default uhid_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_sysfs_xiaomi_fingerprint:dir r_dir_perms;
allow hal_fingerprint_default vendor_sysfs_xiaomi_fingerprint:file rw_file_perms;
allow hal_fingerprint_default vendor_sysfs_xiaomi_touch:dir r_dir_perms;
allow hal_fingerprint_default vendor_sysfs_xiaomi_touch:file rw_file_perms;

# Trusted application
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default vendor_dmabuf_qseecom_heap_device:chr_file r_file_perms;
allow hal_fingerprint_default vendor_dmabuf_qseecom_ta_heap_device:chr_file r_file_perms;
r_dir_file(hal_fingerprint_default, firmware_file)

# Templates
allow hal_fingerprint_default mnt_vendor_file:dir search;
allow hal_fingerprint_default vendor_fingerprint_data_file:dir create_dir_perms;
allow hal_fingerprint_default vendor_fingerprint_data_file:file create_file_perms;

# Sensor manager client
allow hal_fingerprint_default fwk_sensor_service:service_manager find;
binder_call(hal_fingerprint_default, system_server)
