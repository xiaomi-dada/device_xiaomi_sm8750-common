type hal_misys_xiaomi_default, domain;
hal_server_domain(hal_misys_xiaomi_default, hal_misys_xiaomi)

type hal_misys_xiaomi_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_misys_xiaomi_default)

# Watermarks, fonts and filters shared by the camera app and the camera provider
allow hal_misys_xiaomi_default vendor_camera_data_file:dir create_dir_perms;
allow hal_misys_xiaomi_default vendor_camera_data_file:file create_file_perms;
allow hal_misys_xiaomi_default mnt_vendor_file:dir search;
allow hal_misys_xiaomi_default camera_persist_file:dir rw_dir_perms;
allow hal_misys_xiaomi_default camera_persist_file:file create_file_perms;
