type hal_touchfeature_xiaomi_default, domain;
hal_server_domain(hal_touchfeature_xiaomi_default, hal_touchfeature_xiaomi)

type hal_touchfeature_xiaomi_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_touchfeature_xiaomi_default)

allow hal_touchfeature_xiaomi_default self:capability sys_nice;

# Touch host processing
allow hal_touchfeature_xiaomi_default input_device:chr_file rw_file_perms;
allow hal_touchfeature_xiaomi_default input_device:dir r_dir_perms;
allow hal_touchfeature_xiaomi_default touchfeature_device:chr_file rw_file_perms;
allow hal_touchfeature_xiaomi_default uhid_device:chr_file rw_file_perms;
allow hal_touchfeature_xiaomi_default vendor_sysfs_xiaomi_touch:dir r_dir_perms;
allow hal_touchfeature_xiaomi_default vendor_sysfs_xiaomi_touch:file rw_file_perms;

# Runtime state and calibration
allow hal_touchfeature_xiaomi_default mnt_vendor_file:dir search;
allow hal_touchfeature_xiaomi_default persist_touch_file:dir rw_dir_perms;
allow hal_touchfeature_xiaomi_default persist_touch_file:file create_file_perms;
allow hal_touchfeature_xiaomi_default vendor_touch_data_file:dir create_dir_perms;
allow hal_touchfeature_xiaomi_default vendor_touch_data_file:file create_file_perms;

# Sensor manager client (proximity/palm handling)
allow hal_touchfeature_xiaomi_default fwk_sensor_service:service_manager find;
binder_call(hal_touchfeature_xiaomi_default, system_server)
