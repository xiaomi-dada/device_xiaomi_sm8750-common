# Xiaomi sensor service: computes the under-display ambient light from the
# panel brightness and frame content and feeds it to the sensors DSP
type hal_citsensorservice_xiaomi_default, domain;
hal_server_domain(hal_citsensorservice_xiaomi_default, hal_citsensorservice_xiaomi)

type hal_citsensorservice_xiaomi_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_citsensorservice_xiaomi_default)

allow hal_citsensorservice_xiaomi_default self:capability sys_nice;

# Sensors DSP
allow hal_citsensorservice_xiaomi_default self:{ socket qipcrtr_socket } create_socket_perms;
allowxperm hal_citsensorservice_xiaomi_default self:{ socket qipcrtr_socket } ioctl msm_sock_ipc_ioctls;
get_prop(hal_citsensorservice_xiaomi_default, vendor_sensors_prop)
allow hal_citsensorservice_xiaomi_default fwk_sensor_service:service_manager find;
binder_call(hal_citsensorservice_xiaomi_default, system_server)

# Calibration
allow hal_citsensorservice_xiaomi_default mnt_vendor_file:dir search;
allow hal_citsensorservice_xiaomi_default vendor_persist_sensors_file:dir create_dir_perms;
allow hal_citsensorservice_xiaomi_default vendor_persist_sensors_file:file create_file_perms;
allow hal_citsensorservice_xiaomi_default vendor_sensors_vendor_data_file:dir rw_dir_perms;
allow hal_citsensorservice_xiaomi_default vendor_sensors_vendor_data_file:file create_file_perms;

# Display state, brightness and frame content
allow hal_citsensorservice_xiaomi_default vendor_displayfeature_device:chr_file rw_file_perms;
r_dir_file(hal_citsensorservice_xiaomi_default, vendor_sysfs_displayfeature)
r_dir_file(hal_citsensorservice_xiaomi_default, vendor_sysfs_graphics)
hal_client_domain(hal_citsensorservice_xiaomi_default, hal_graphics_allocator)
hal_client_domain(hal_citsensorservice_xiaomi_default, hal_graphics_composer)
allow hal_citsensorservice_xiaomi_default vendor_qdisplay_service:service_manager find;

# Algorithm state
set_prop(hal_citsensorservice_xiaomi_default, vendor_cct_prop)
set_prop(hal_citsensorservice_xiaomi_default, vendor_mischeck_prop)
set_prop(hal_citsensorservice_xiaomi_default, vendor_parsedalgo_prop)
set_prop(hal_citsensorservice_xiaomi_default, vendor_usedframebuffer_prop)
