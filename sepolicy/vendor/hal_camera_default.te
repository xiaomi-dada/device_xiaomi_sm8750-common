allow hal_camera_default self:capability { fowner ipc_lock };

allow hal_camera_default fs_bpf_vendor:dir search;
allow hal_camera_default fs_bpf_vendor:file { read write };

allow hal_camera_default vendor_dio_dma_mapper_device:chr_file rw_file_perms;

# Xiaomi camera services registered by the camera provider
add_service(hal_camera_default, hal_aidlbgservice_service)
add_service(hal_camera_default, hal_camera_aon_service)
add_service(hal_camera_default, hal_dynamic_camera_service)
add_service(hal_camera_default, hal_quickcamera_service)

# Sensor calibration on persist
r_dir_file(hal_camera_default, mnt_vendor_file)
r_dir_file(hal_camera_default, vendor_persist_sensors_file)

# Local sockets in /data/vendor/camera
allow hal_camera_default vendor_camera_data_file:sock_file create_file_perms;

# The provider publishes its P3 and XDR support and per sensor info
set_prop(hal_camera_default, vendor_camera_p3enable_prop)
set_prop(hal_camera_default, vendor_camera_sensor_prop)
set_prop(hal_camera_default, vendor_camera_xdrversion_prop)

# libcameraopt waits for bpf.progs_loaded while the provider initializes
typeattribute hal_camera_default bpfdomain;

# Memory and thermal state used to tune processing
allow hal_camera_default proc_meminfo:file r_file_perms;
allow hal_camera_default { proc_pressure_cpu proc_pressure_io proc_pressure_mem }:file rw_file_perms;
r_dir_file(hal_camera_default, vendor_sysfs_battery_supply)

# Display state for the front flash
allow hal_camera_default vendor_displayfeature_device:chr_file r_file_perms;

# Frame boost state of the Xiaomi scheduler
r_dir_file(hal_camera_default, vendor_sysfs_metis)
