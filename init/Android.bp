    name: "init.kernel.post_boot-memory.sh",
    src: "init.kernel.post_boot-memory.sh",
    vendor: true,
}

sh_binary {
    name: "init.kernel.post_boot-sun.sh",
    src: "init.kernel.post_boot-sun.sh",
    vendor: true,
}

sh_binary {
    name: "init.kernel.post_boot-sun_default_6_2.sh",
